#!/bin/sh

set -eu

. "$(dirname -- "$0")/common.sh"

prepare_runtime_dirs
export_runtime_env
clear_stale_pid
require_file "${SERVER_BIN}" "server 二进制"

pid=$(read_pid || true)
if [ -n "${pid}" ] && is_running_pid "${pid}"; then
  log_msg "拒绝生成 Web 初始化凭据：motrix-fnos-server 仍在运行"
  echo "motrix-fnos-server 仍在运行，请先停止应用后重试" >&2
  exit 1
fi

if "${SERVER_BIN}" bootstrap-web-auth; then
  log_msg "Web 管理初始化凭据已在本地生成"
  exit 0
fi

log_msg "Web 管理初始化凭据生成失败"
echo "Web 管理初始化凭据生成失败，请检查本地服务日志" >&2
exit 1
