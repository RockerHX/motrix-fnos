#!/bin/sh
set -eu

. "$(dirname -- "$0")/common.sh"
prepare_runtime_dirs
export_runtime_env
generation_file="${APP_DEST}/bin/engine-generation"
if [ ! -r "${generation_file}" ]; then
  log_msg "升级检查失败：缺少引擎代际声明"
  exit 1
fi
generation=$(sed -n '1{s/[[:space:]]//g;p;}' "${generation_file}")
case "${generation}" in
  legacy-v1) exit 0 ;;
  native-v2) : ;;
  *) log_msg "升级检查失败：引擎代际未知"; exit 1 ;;
esac
if ! ensure_uninstall_processes_stopped; then
  log_msg "升级检查失败：服务或引擎仍在运行"
  exit 1
fi
require_file "${CMD_DIR}/upgrade-checker" "独立升级检查工具"
MOTRIX_FNOS_APP_DATA_DIR="${APP_DATA_DIR}" MOTRIX_FNOS_ARIA2_PATH="${ARIA2_BIN}" \
  "${CMD_DIR}/upgrade-checker" engine-upgrade-check
