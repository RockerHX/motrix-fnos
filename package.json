{
  "name": "motrix-fnos",
  "private": true,
  "version": "1.8.5",
  "packageManager": "pnpm@11.17.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build/build-web.mjs",
    "preview": "vite preview",
    "test:scripts": "node --test --test-reporter=./scripts/verify/test-duration-reporter.mjs scripts/tests/*.test.mjs",
    "test:unit": "vitest run --reporter=./scripts/verify/vitest-progress-reporter.mjs",
    "typecheck": "vue-tsc --noEmit",
    "clean": "node scripts/maintenance/clean-generated.mjs",
    "clean:dry-run": "node scripts/maintenance/clean-generated.mjs --dry-run",
    "clean:rust": "node scripts/maintenance/clean-rust-target.mjs",
    "version:set": "node scripts/version/version-set.mjs",
    "version:check": "node scripts/version/version-check.mjs",
    "release:prepare": "node scripts/release/release-prepare.mjs",
    "release:notes": "node scripts/release/release-notes.mjs",
    "verify": "node scripts/verify/verify.mjs",
    "verify:pre-commit": "node scripts/verify/verify.mjs --quick",
    "verify:fpk": "node scripts/verify/verify-fpk-artifacts.mjs",
    "audit:deps": "node scripts/verify/dependency-audit.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "hooks:install": "git config core.hooksPath .githooks",
    "build:server:linux:x64": "node scripts/build/build-server-linux.mjs",
    "build:web:fpk": "node scripts/build/build-web-ui-fpk.mjs",
    "assets:aria2:fetch": "node scripts/build/fetch-aria2-next.mjs",
    "stage:aria2:x64": "node scripts/build/stage-aria2-sidecar.mjs --target x86_64-unknown-linux-gnu",
    "stage:aria2:arm64": "node scripts/build/stage-aria2-sidecar.mjs --target aarch64-unknown-linux-gnu",
    "build:fpk:x64": "node scripts/build/build-fpk.mjs --target x86_64-unknown-linux-gnu",
    "build:fpk:arm64": "node scripts/build/build-fpk.mjs --target aarch64-unknown-linux-gnu",
    "build:fpk:prepare": "node scripts/build/build-fpk-all.mjs --prepare-only",
    "build:fpk:artifacts": "node scripts/build/build-fpk-all.mjs",
    "build:fpk": "node scripts/build/package-local.mjs"
  },
  "dependencies": {
    "@tabler/icons-vue": "^3.46.0",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "js-tiktoken": "1.0.21",
    "jsdom": "^29.1.1",
    "typescript": "~5.6.3",
    "unocss": "^66.7.5",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.12"
  }
}
