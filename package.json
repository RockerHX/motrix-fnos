{
  "name": "motrix-fnos",
  "private": true,
  "version": "1.7.4",
  "packageManager": "pnpm@11.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "test:unit": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "clean": "node scripts/clean-generated.mjs",
    "clean:dry-run": "node scripts/clean-generated.mjs --dry-run",
    "clean:rust": "node scripts/clean-rust-target.mjs",
    "clean:rust:incremental": "node scripts/clean-rust-target.mjs --incremental",
    "version:set": "node scripts/version-set.mjs",
    "version:check": "node scripts/version-check.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:pre-commit": "node scripts/verify.mjs --quick",
    "prepare": "git config core.hooksPath .githooks || true",
    "hooks:install": "git config core.hooksPath .githooks",
    "build:server:linux:x64": "node scripts/build-server-linux.mjs",
    "build:web:fpk": "node scripts/build-web-ui-fpk.mjs",
    "assets:aria2:fetch": "node scripts/fetch-aria2-next.mjs",
    "stage:aria2:x64": "node scripts/stage-aria2-sidecar.mjs --target x86_64-unknown-linux-gnu",
    "stage:aria2:arm64": "node scripts/stage-aria2-sidecar.mjs --target aarch64-unknown-linux-gnu",
    "build:fpk:x64": "node scripts/build-fpk.mjs --target x86_64-unknown-linux-gnu",
    "build:fpk:arm64": "node scripts/build-fpk.mjs --target aarch64-unknown-linux-gnu",
    "build:fpk:prepare": "node scripts/build-fpk-all.mjs --prepare-only",
    "build:fpk": "node scripts/build-fpk-all.mjs"
  },
  "dependencies": {
    "@tabler/icons-vue": "^3.44.0",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "js-tiktoken": "1.0.21",
    "jsdom": "^29.1.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^2.1.10"
  }
}
