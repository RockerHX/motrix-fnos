#!/usr/bin/env node
import { execFileSync, spawnSync } from 'node:child_process';
import { readFileSync } from 'node:fs';
import { classifyVerificationFile } from '../scripts/lib/verification-inputs.mjs';

const suites = new Set();
const shellTests = new Set();
let hasBranchUpdate = false;
let full = false;

for (const line of readFileSync(0, 'utf8').trim().split(/\r?\n/).filter(Boolean)) {
  const fields = line.trim().split(/\s+/);
  if (fields.length !== 4) {
    full = true;
    continue;
  }
  const [, localOid, remoteRef, remoteOid] = fields;
  if (!remoteRef.startsWith('refs/heads/') || /^0+$/.test(localOid)) continue;
  hasBranchUpdate = true;
  // 新分支没有远端基线，不能只检查最后一个提交就跳过验证。
  if (/^0+$/.test(remoteOid)) {
    full = true;
    continue;
  }
  let files;
  try {
    files = execFileSync('git', ['diff', '--name-only', '--no-renames', '-z', remoteOid, localOid, '--'],
      { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] }).split('\0').filter(Boolean);
  } catch {
    full = true;
    continue;
  }
  for (const file of files) {
    switch (classifyVerificationFile(file)) {
      case 'scripts-test': suites.add('scripts'); break;
      case 'aria2-test': suites.add('aria2'); break;
      case 'browser-test': suites.add('browser'); break;
      case 'frontend-test': suites.add('frontend'); break;
      case 'stability-test': suites.add('rust'); suites.add('stability'); break;
      case 'rust-test': suites.add('rust'); break;
      case 'shell-test': shellTests.add(file); break;
      case 'checked-docs': suites.add('docs'); break;
      case 'docs': break;
      default: full = true;
    }
  }
}

if (!full && suites.size === 0 && shellTests.size === 0) {
  console.log(hasBranchUpdate ? '仅普通说明文档或无文件变化，跳过业务验证。' : '未推送分支源码，跳过业务验证。');
  process.exit(0);
}

const packageManager = spawnSync('pnpm', ['--version'], { stdio: 'ignore' }).status === 0 ? 'pnpm' : 'npm';
if (full) {
  console.log('包含源码、运行资源或配置，按组核对或执行验证。');
  run(packageManager, ['run', 'verify', '--', '--reuse']);
} else {
  console.log('仅测试或维护文档改动，运行对应检查，不执行完整构建。');
  if (suites.has('scripts')) run(packageManager, ['run', 'test:scripts']);
  else if (suites.has('docs')) run('node', ['--test', 'scripts/tests/logging-docs.test.mjs']);
  if (suites.has('rust')) run('node', ['scripts/verify/run-rust-tests.mjs']);
  if (suites.has('stability')) run(packageManager, ['run', 'test:stability']);
  if (suites.has('frontend')) run(packageManager, ['run', 'test:unit']);
  if (suites.has('browser')) run(packageManager, ['run', 'test:e2e']);
  if (suites.has('aria2')) run(packageManager, ['run', 'test:aria2']);
  for (const file of shellTests) run('sh', [file]);
}

function run(command, args) {
  const result = spawnSync(command, args, { stdio: 'inherit' });
  if (result.error) console.error(result.error.message);
  if (result.status !== 0) process.exit(result.status ?? 1);
}
